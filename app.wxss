/* app.wxss - 全局样式 */

/* 基础样式重置 */
view, text, input, button, image, picker, canvas, swiper, swiper-item {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 32rpx;
  line-height: 1.5;
  color: #333;
  background-color: #f5f5f5;
}

/* 通用布局样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 按钮样式 */
.btn {
  display: inline-block;
  padding: 16rpx 40rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
  margin: 10rpx 0;
  cursor: pointer;
}

.btn:active {
  opacity: 0.8;
}

.btn-disabled {
  background-color: #ccc;
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 16rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 32rpx;
  margin: 10rpx 0;
}

/* 固定顶部栏样式 */
.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  padding-top: var(--status-bar-height, 0);
  background-color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  box-sizing: content-box;
}

/* 毛玻璃效果 */
.glass {
  backdrop-filter: blur(10rpx);
  background-color: rgba(255, 255, 255, 0.7);
}

/* 轮播图样式 */
.swiper {
  width: 100%;
  height: 400rpx;
  margin: 0 auto;
}

.swiper-item {
  display: flex;
  align-items: center;
  justify-content: center;
}

.swiper-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 表单行样式 */
.form-row {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
}

.form-label {
  width: 160rpx;
  font-size: 32rpx;
  color: #666;
}

.form-content {
  flex: 1;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 16rpx;
  width: 80%;
  max-width: 600rpx;
  padding: 40rpx;
}

.modal-header {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  text-align: center;
}

.modal-footer {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
}

/* 列表样式 */
.list {
  background-color: #fff;
  border-radius: 8rpx;
  overflow: hidden;
}

.list-item {
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-item:last-child {
  border-bottom: none;
}

/* 分隔线 */
.divider {
  height: 20rpx;
  background-color: #f5f5f5;
}

/* 价格样式 */
.price {
  color: #e64340;
  font-weight: bold;
}

/* 备注样式 */
.remark {
  color: #999;
  font-size: 28rpx;
}

/* 订单样式 */
.order-item {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-no {
  font-size: 28rpx;
  color: #666;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-content {
  margin-left: 20rpx;
}

.order-item-list {
  margin-bottom: 20rpx;
}

.order-item-detail {
  font-size: 28rpx;
  margin-bottom: 10rpx;
  color: #666;
}

.order-total {
  text-align: right;
  font-weight: bold;
  color: #e64340;
}

/* 地址样式 */
.address-item {
  padding: 20rpx;
  background-color: #fff;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 1rpx 5rpx rgba(0, 0, 0, 0.05);
}

.address-item.selected {
  border: 2rpx solid #1890ff;
}

/* 购物车样式 */
.cart-item {
  background-color: #fff;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.cart-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.cart-item-content {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #666;
}

/* 登录页面样式 */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 40rpx;
}

.login-logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.login-form {
  width: 100%;
  max-width: 600rpx;
}

.login-input {
  width: 100%;
  padding: 20rpx;
  font-size: 32rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.login-btn {
  width: 100%;
  padding: 20rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 36rpx;
  border: none;
  border-radius: 8rpx;
  cursor: pointer;
  margin-top: 20rpx;
}

.login-btn:active {
  opacity: 0.8;
}

/* 提示文本 */
.tip {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
  text-align: center;
}

/* 全局picker样式 - 尝试实现iOS毛玻璃效果 */
/* 注意：微信小程序picker样式受系统限制，部分样式可能无法自定义 */

/* 增大picker选择器中的文字大小 */
picker {  
  /* 正常状态下的样式 */
  font-size: 28rpx;
}

/* 尝试影响picker弹窗的样式 */
picker::after {
  backdrop-filter: blur(10rpx);
  background-color: rgba(255, 255, 255, 0.7);
}

/* 自定义picker-view样式 */
picker-view {
  font-size: 48rpx !important;
  backdrop-filter: blur(10rpx) !important;
  background-color: rgba(255, 255, 255, 0.8) !important;
  border-radius: 20rpx !important;
}

picker-view-column {
  font-size: 48rpx !important;
}

picker-view-item {
  font-size: 48rpx !important;
}

/* 选中项样式 */
picker-view-item.picker-view-item-selected {
  font-size: 48rpx !important;
  color: #1890ff !important;
  font-weight: bold !important;
}